{
  "components": {
    "parameters": {
      "Account": {
        "description": "Account number",
        "in": "query",
        "name": "account",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Application": {
        "description": "If set, content is associated with a specific CRC application",
        "explode": true,
        "in": "query",
        "name": "application",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "Bundle": {
        "description": "If set, content is associated with a specific CRC bundle",
        "explode": true,
        "in": "query",
        "name": "bundle",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "Content": {
        "description": "If set, content is associated with a specific CRC content",
        "explode": true,
        "in": "query",
        "name": "content",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "DisplayName": {
        "description": "Search quickstarts by display name",
        "explode": true,
        "in": "query",
        "name": "display-name",
        "required": false,
        "schema": {
          "type": "string"
        },
        "style": "form"
      },
      "FuzzySearch": {
        "description": "Enable fuzzy search using Levenshtein distance for typo tolerance (searches spec.displayName)",
        "explode": true,
        "in": "query",
        "name": "fuzzy",
        "required": false,
        "schema": {
          "default": false,
          "type": "boolean"
        },
        "style": "form"
      },
      "Id": {
        "description": "identifier",
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "Kind": {
        "description": "If set, content is associated with a specific kind",
        "explode": true,
        "in": "query",
        "name": "kind",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "Limit": {
        "description": "Pagination limit",
        "explode": true,
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "type": "integer"
        },
        "style": "form"
      },
      "Name": {
        "description": "Search content by name",
        "explode": true,
        "in": "query",
        "name": "name",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "Offset": {
        "description": "Pagination offset",
        "explode": true,
        "in": "query",
        "name": "offset",
        "required": false,
        "schema": {
          "type": "integer"
        },
        "style": "form"
      },
      "ProductFamilies": {
        "description": "If set, content is associated with a specific CRC product families",
        "explode": true,
        "in": "query",
        "name": "product-families",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "QuickstartName": {
        "description": "Search quickstarts by name",
        "explode": true,
        "in": "query",
        "name": "name",
        "required": false,
        "schema": {
          "type": "string"
        },
        "style": "form"
      },
      "Topic": {
        "description": "If set, content is associated with a specific topic",
        "explode": true,
        "in": "query",
        "name": "topic",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      },
      "TopicName": {
        "description": "identifier",
        "in": "path",
        "name": "name",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "UseCase": {
        "description": "If set, content is associated with a specific CRC use case",
        "explode": true,
        "in": "query",
        "name": "use-case",
        "required": false,
        "schema": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "style": "form"
      }
    },
    "schemas": {
      "BadRequest": {
        "properties": {
          "msg": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "BatchPrMetadata": {
        "properties": {
          "baseSha": {
            "description": "Base-branch commit the files were read from",
            "type": "string"
          },
          "branchName": {
            "description": "New branch for a first save; must start with qs-update- or qs-create-",
            "type": "string"
          },
          "commitMessage": {
            "type": "string"
          },
          "expectedHeadSha": {
            "description": "PR head the edits were made against; required with prNumber",
            "type": "string"
          },
          "prBody": {
            "type": "string"
          },
          "prNumber": {
            "description": "Existing creator PR to append to; omit to open a new PR",
            "type": "integer"
          },
          "prTitle": {
            "description": "Required when opening a new PR",
            "type": "string"
          },
          "userEmail": {
            "type": "string"
          }
        },
        "required": [
          "commitMessage"
        ],
        "type": "object"
      },
      "BatchPrRequest": {
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/BatchPrMetadata"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/BatchResource"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "metadata",
          "resources"
        ],
        "type": "object"
      },
      "BatchPrResponse": {
        "properties": {
          "branchName": {
            "type": "string"
          },
          "headSha": {
            "type": "string"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "prNumber": {
            "type": "integer"
          },
          "prUrl": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "BatchResource": {
        "properties": {
          "create": {
            "description": "The quickstart is new. Its directory must not exist on the branch, and files must be exactly its metadata file and content file, both declaring this name.",
            "type": "boolean"
          },
          "files": {
            "description": "Changed files only; omitted files are left untouched. A new quickstart sends all of its files.",
            "items": {
              "$ref": "#/components/schemas/SubmitPrFile"
            },
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "description": "Quickstart directory name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "files"
        ],
        "type": "object"
      },
      "CreatorPrContentResponse": {
        "properties": {
          "branchName": {
            "type": "string"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/SubmitPrFile"
            },
            "type": "array"
          },
          "htmlUrl": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreatorPrEntry": {
        "properties": {
          "branchName": {
            "type": "string"
          },
          "htmlUrl": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreatorPrResourceResponse": {
        "properties": {
          "headSha": {
            "type": "string"
          },
          "resource": {
            "$ref": "#/components/schemas/WorkspaceResource"
          }
        },
        "type": "object"
      },
      "CreatorPrWorkspaceResponse": {
        "properties": {
          "branchName": {
            "type": "string"
          },
          "headSha": {
            "type": "string"
          },
          "htmlUrl": {
            "type": "string"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "number": {
            "type": "integer"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceResource"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "FavoriteQuickstart": {
        "properties": {
          "accountId": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {},
          "favorite": {
            "type": "boolean"
          },
          "id": {
            "minimum": 0,
            "type": "integer"
          },
          "quickstartName": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HelpTopic": {
        "properties": {
          "content": {
            "format": "byte",
            "type": "object"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {
            "format": "date-time",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "id": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "type": "array"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ListCreatorPrsResponse": {
        "properties": {
          "pullRequests": {
            "items": {
              "$ref": "#/components/schemas/CreatorPrEntry"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ListRepoQuickstartsResponse": {
        "properties": {
          "headSha": {
            "description": "Base-branch commit the listing was read from",
            "type": "string"
          },
          "quickstarts": {
            "items": {
              "$ref": "#/components/schemas/RepoQuickstartEntry"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "NotFound": {
        "properties": {
          "msg": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Quickstart": {
        "properties": {
          "content": {
            "format": "byte",
            "type": "object"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {
            "format": "date-time",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "type": "string"
          },
          "favoriteQuickstart": {
            "items": {
              "$ref": "#/components/schemas/FavoriteQuickstart"
            },
            "type": "array"
          },
          "id": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "type": "array"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "QuickstartContentResponse": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/SubmitPrFile"
            },
            "type": "array"
          },
          "headSha": {
            "description": "Base-branch commit the files were read from",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "QuickstartProgress": {
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "progress": {
            "additionalProperties": true,
            "type": "object"
          },
          "quickstartName": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "QuickstartProgressRequest": {
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "progress": {
            "additionalProperties": true,
            "type": "object"
          },
          "quickstartName": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "quickstartName"
        ],
        "type": "object"
      },
      "RepoQuickstartEntry": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResourceFile": {
        "properties": {
          "content": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SubmitPrFile": {
        "properties": {
          "content": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "content"
        ],
        "type": "object"
      },
      "SubmitPrMetadata": {
        "properties": {
          "branchName": {
            "type": "string"
          },
          "commitMessage": {
            "type": "string"
          },
          "directoryName": {
            "description": "Directory name for the quickstart (e.g. insights-integrate-satellite-iop). Defaults to branchName if not set.",
            "type": "string"
          },
          "existingPath": {
            "type": "string"
          },
          "isUpdate": {
            "default": false,
            "type": "boolean"
          },
          "prBody": {
            "type": "string"
          },
          "prNumber": {
            "description": "Existing PR number; used to return prUrl on force-push update.",
            "type": "integer"
          },
          "prTitle": {
            "type": "string"
          },
          "userEmail": {
            "type": "string"
          }
        },
        "required": [
          "branchName",
          "commitMessage",
          "prTitle"
        ],
        "type": "object"
      },
      "SubmitPrRequest": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/SubmitPrFile"
            },
            "minItems": 1,
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/SubmitPrMetadata"
          }
        },
        "required": [
          "files",
          "metadata"
        ],
        "type": "object"
      },
      "SubmitPrResponse": {
        "properties": {
          "branchName": {
            "type": "string"
          },
          "commitSha": {
            "type": "string"
          },
          "prUrl": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Tag": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {
            "format": "date-time",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ],
            "type": "string"
          },
          "id": {
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "WorkspaceResource": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/ResourceFile"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "license": {
      "name": "MIT"
    },
    "title": "quickstarts",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/creator-prs": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ListCreatorPrsResponse"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Open PRs with head branches starting with qs-create- or qs-update-"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Git-service is not available"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Git service error"
          }
        },
        "summary": "List open creator pull requests"
      }
    },
    "/creator-prs/{number}": {
      "get": {
        "parameters": [
          {
            "description": "GitHub pull request number",
            "in": "path",
            "name": "number",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CreatorPrContentResponse"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "PR metadata and files"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Bad request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "PR not found or git-service is not available"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "PR changes more than one quickstart; load its workspace instead"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Git service error"
          }
        },
        "summary": "Get one creator pull request and its quickstart files"
      }
    },
    "/creator-prs/{number}/resources/{name}": {
      "get": {
        "parameters": [
          {
            "description": "GitHub pull request number",
            "in": "path",
            "name": "number",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Quickstart directory name",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Head the caller loaded; returns 409 if the PR has moved since",
            "in": "query",
            "name": "headSha",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CreatorPrResourceResponse"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Quickstart files at the PR head"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Bad request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "PR or quickstart not found, or git-service is not available"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "PR head does not match headSha"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Git service error"
          }
        },
        "summary": "Get one quickstart read at a creator pull request's head"
      }
    },
    "/creator-prs/{number}/workspace": {
      "get": {
        "parameters": [
          {
            "description": "GitHub pull request number",
            "in": "path",
            "name": "number",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CreatorPrWorkspaceResponse"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "PR identity and complete quickstart snapshots"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Bad request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "PR not found or git-service is not available"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "PR changes too many files to load"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            },
            "description": "Git service error"
          }
        },
        "summary": "Get every quickstart a creator pull request touches, read at its head"
      }
    },
    "/favorites": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/Account"
          }
